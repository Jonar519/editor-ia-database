# Cuaderno · editor-ia-database · variables de entorno
#
# Crea (o completa) tu .env local con:  scripts\env-init.bat   (db-up.bat lo llama solo)
# El script copia este archivo y genera las contraseñas aleatorias. Si .env ya existe, solo agrega
# las variables nuevas que falten, sin cambiar las existentes. .env nunca se versiona.

# Host de PostgreSQL. 127.0.0.1 (no "localhost") para no depender de IPv6 ni del archivo hosts.
PGHOST=127.0.0.1

# Puerto de PostgreSQL en el host. 5435 para no chocar con otros proyectos.
PGPORT=5435

# Usuario dueño de las bases locales (solo desarrollo).
PGUSER=cuaderno

# Contraseña local de PostgreSQL. Déjala vacía aquí: env-init.bat genera una con
# 24 bytes aleatorios (crypto.randomBytes). Para generarla a mano:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PGPASSWORD=

# Contraseña del rol de aplicación cuaderno_app (privilegios mínimos; es el usuario con el que se conecta
# el backend). Déjala vacía aquí: env-init.bat la genera igual que PGPASSWORD. db-up.bat la aplica al rol.
CUADERNO_APP_PASSWORD=

# Base de desarrollo (la tuya). Las pruebas NUNCA escriben aquí; la huella solo la lee.
CUADERNO_DEV_DB=cuaderno

# Base de pruebas. Tiene que terminar en _test: el runner se niega a borrar cualquier otra.
CUADERNO_TEST_DB=cuaderno_test

# Puerto de Redis en el host. 6381 para no chocar con otros proyectos.
# Bases lógicas: 0 = desarrollo, 1 = pruebas, 2 = E2E.
REDIS_PORT=6381
